# Copy to .env.local and fill in real values. Also add these to the Vercel
# project (Settings -> Environment Variables) before deploying.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# NO SERVICE-ROLE KEY HERE, ON PURPOSE.
# The support form writes through the security-definer RPC
# public.submit_support_request(), which the anon key may call and nothing else.
# See supabase/migrations/20260822000000_submit_support_request.sql.
# If you find SUPABASE_SERVICE_ROLE_KEY set in Vercel or in .env.local, delete
# it: on this site it would grant RLS-bypassing read/write access to every table
# in the production app, including rented phone numbers and received SMS text.

N8N_SUPPORT_WEBHOOK_URL=https://n8n.dopplervpn.org/webhook/simnetiq-support
N8N_WEBHOOK_SECRET=REPLACE-WITH-RANDOM-SECRET

# Salt for the one-way hash of the submitter's IP stored on support requests.
# Any long random string (`openssl rand -hex 32`). Leave unset and no IP-derived
# value is stored at all — the per-source flood gate in the RPC then never
# triggers, which is the safe default, not a broken one.
SUPPORT_IP_HASH_SALT=

# Cloudflare Turnstile. Optional: with both blank the form behaves exactly as it
# does today. Set BOTH or NEITHER — a secret without a site key would reject
# every real submission, so the route deliberately skips the check in that case
# and logs loudly instead.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Gates VISIBILITY of /admin, not access. Access is password + TOTP +
# is_admin() in Postgres — this only decides whether the page renders at all
# instead of the site's 404. Treat a leak as "someone can see a sign-in form".
# Generate with: openssl rand -hex 24
# Visit /admin?k=<the value> once; middleware.ts stores it in an httpOnly
# cookie scoped to /admin for 180 days and strips the query string.
# Leave it unset and /admin is a 404 for everyone, including you — unset fails
# closed on purpose and never means "open".
ADMIN_ENTRY_SECRET=REPLACE-WITH-RANDOM-SECRET
